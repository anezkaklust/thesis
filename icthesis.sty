\pagestyle{empty}

\setlength{\parskip}{2ex plus 0.5ex minus 0.2ex}
\setlength{\parindent}{0pt}

\makeatletter  %to avoid error messages generated by "\@". Makes Latex treat "@" like a letter

\linespread{1.5}
\def\submitdate#1{\gdef\@submitdate{#1}}

\def\maketitle{
  \begin{titlepage}{
    %\linespread{1.5}
    \Large 
    Imperial College London \\
    %\linebreak
    Department of Physics
    \rm
    \vskip 3in
    \Large \bf \@title \par
  }
  \vskip 0.3in
  \par
  {\Large \@author}
  \vskip 4in
  \par
  Submitted to Imperial College London in partial fulfilment 
  \linebreak
  of the requirements for the degree of
  Doctor of Philosophy in Physics.
  \linebreak
  \linebreak
  \@submitdate
  \vfil
  \end{titlepage}
}

\def\titlepage{
  \newpage
  \centering
  \linespread{1}
  \normalsize
  \vbox to \vsize\bgroup\vbox to 9in\bgroup
}
\def\endtitlepage{
  \par
  \kern 0pt
  \egroup
  \vss
  \egroup
  \cleardoublepage
}

\def\abstract{
  \begin{center}{
    \Large\bf Abstract}
  \end{center}
  \small
  %\def\baselinestretch{1.5}
  \linespread{1.5}
  \normalsize
}
\def\endabstract{
  \par
  \clearpage
  \thispagestyle{empty}
  \cleardoublepage
}

\newenvironment{declaration}{
  \cleardoublepage
  \begin{center}{
    \Large \bf Statement of originality}
  \end{center}
  \small
  \linespread{1.5}
  \normalsize
}{\cleardoublepage}
\def\enddeclaration{
  \par
}

\newenvironment{acknowledgements}{
  \cleardoublepage
  \begin{center}{
    \Large \bf Acknowledgements}
  \end{center}
  \small
  \linespread{1.5}
  \normalsize
}{\cleardoublepage}
\def\endacknowledgements{
  \par
}

\newenvironment{declarationcopyright}{
  \cleardoublepage
  \begin{center}{
    \Large \bf  Copyright declaration}
  \end{center}
  \small
  \linespread{1.5}
  \normalsize
}{\cleardoublepage}
\def\enddeclarationcopyright{
  \par
  \clearpage
  \thispagestyle{empty}
  \cleardoublepage
}



\def\preface{
    \pagenumbering{roman}
    \pagestyle{plain}
    \doublespacing
}

\def\body{
    \cleardoublepage   
    \pagestyle{fancy}
    \fancyhf{}
    \fancyhead[LE]{\thepage\hfill\nouppercase{\rightmark}}
    \fancyhead[RO]{\nouppercase{\rightmark}\hfill\thepage}
    %\fancyhead[L]{\nouppercase{\rightmark}}
    %\fancyhead[R]{\thepage}
    \singlespacing
    \tableofcontents
    %\pagestyle{plain}
    \clearpage
    \thispagestyle{empty}
    \cleardoublepage
    %\pagestyle{uheadings}
    \listoffigures
    \clearpage
    %\pagestyle{plain}
    \cleardoublepage
    %\pagestyle{uheadings}
    \listoftables
    \clearpage
    %\pagestyle{plain}
    \cleardoublepage
    %\pagestyle{uheadings}
    \input{glossary/glossary.tex}
    %\pagestyle{plain}
    \clearpage
    \thispagestyle{empty}
    \cleardoublepage
    \pagestyle{uheadings}
    \pagenumbering{arabic}
    \doublespacing
}

\makeatother  %to avoid error messages generated by "\@". Makes Latex treat "@" like a letter